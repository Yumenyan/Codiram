{
  "format": "codiram-generator",
  "schemaVersion": 2,
  "kind": "syntax",
  "generator": {
    "id": "python",
    "name": {
      "ja": "Python CLI",
      "en": "Python CLI"
    },
    "icon": "🐍",
    "desc": {
      "ja": "Python のコマンドラインスクリプトを生成します",
      "en": "Generates a Python command-line script"
    },
    "version": "0.1.0"
  },
  "target": {
    "language": [
      "python"
    ],
    "platforms": [
      "windows",
      "macos",
      "linux"
    ]
  },
  "capabilities": [
    "variables",
    "conditions",
    "loops",
    "functions",
    "filesystem",
    "cli",
    "io"
  ],
  "types": {
    "true": "True",
    "false": "False",
    "null": "None",
    "toStr": "str({a})",
    "toStrNum": "fmt_num({a})",
    "toNum": "to_num({a})",
    "toBool": "bool({a})"
  },
  "expressions": {
    "not": "(not {a})",
    "neg": "(-{a})",
    "concat": " + ",
    "ops": {
      "&&": "and",
      "||": "or"
    },
    "calls": {
      "contains": "({b} in {a})",
      "isEmpty": "(len({a}) == 0)",
      "pow": "({a} ** {b})",
      "random": "random.randint(int({a}), int({b}))",
      "ternary": "({b} if {a} else {c})"
    }
  },
  "statements": {
    "comment": "# {text}",
    "globalDecl": "{name} = {value}",
    "set": "{target} = {value}",
    "log": "print({value})",
    "call": "{fn}({args})",
    "wait": "time.sleep({ms} / 1000)",
    "print": "print({value})",
    "printInline": "print({value}, end=\"\", flush=True)",
    "exit": "sys.exit(int({code}))"
  },
  "io": {
    "readLine": "sys.stdin.readline().rstrip(\"\\r\\n\")",
    "arg": "(sys.argv[int({a})] if len(sys.argv) > int({a}) else \"\")",
    "readFile": "read_file({a})",
    "fileExists": "os.path.exists({a})",
    "writeFile": "open({path}, \"w\", encoding=\"utf-8\").write({text})",
    "appendFile": "open({path}, \"a\", encoding=\"utf-8\").write({text})"
  },
  "conditions": {
    "ifOpen": "if {cond}:",
    "elseOpen": "else:"
  },
  "loops": {
    "repeatOpen": "for {i} in range(int({count})):"
  },
  "functions": {
    "fnOpen": "def {name}({params}):",
    "fnGlobals": "global {names}"
  },
  "events": {
    "mainOpen": "if __name__ == \"__main__\":"
  },
  "syntax": {
    "indent": "    ",
    "close": "",
    "emptyBody": "pass"
  },
  "mappings": {
    "imports": {
      "wait": "import time",
      "random": "import random",
      "exit": "import sys",
      "arg": "import sys",
      "readLine": "import sys",
      "fileExists": "import os"
    },
    "helpers": {
      "toStrNum": "def fmt_num(value):\n    \"\"\"Number to text like JavaScript: 3 instead of 3.0.\"\"\"\n    return str(int(value)) if float(value).is_integer() else str(value)",
      "toNum": "def to_num(value):\n    try:\n        return float(value)\n    except (TypeError, ValueError):\n        return 0.0",
      "readFile": "def read_file(path):\n    try:\n        with open(path, encoding=\"utf-8\") as f:\n            return f.read()\n    except OSError:\n        return \"\""
    }
  },
  "templates": {
    "program": {
      "file": "main.py",
      "template": "#!/usr/bin/env python3\n\"\"\"{{name}} — generated by Codiram. Plain Python: edit freely.\"\"\"\n{{imports}}\n\n{{helpers}}\n\n{{globals}}\n\n{{functions}}\n\n{{main}}\n"
    },
    "files": {
      "README.md": "# {{name}}\n\nA command-line script generated by [Codiram](https://github.com/Yumenyan/Codiram) (Python generator).\nPlain Python 3, no dependencies — Codiram is not needed to run or edit it.\n\n```sh\npython3 main.py\n```\n",
      ".gitignore": "__pycache__/\n"
    }
  },
  "scaffold": {
    "config": {
      "version": "0.1.0"
    },
    "configFields": [
      {
        "key": "version",
        "label": "Version"
      }
    ]
  },
  "verify": {
    "requiredFiles": [
      "main.py",
      "README.md"
    ],
    "contains": {
      "main.py": [
        "def "
      ]
    },
    "run": {
      "tool": "python3",
      "args": [
        "main.py"
      ]
    }
  }
}
