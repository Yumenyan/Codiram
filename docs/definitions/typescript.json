{
  "format": "codiram-generator",
  "schemaVersion": 2,
  "kind": "syntax",
  "generator": {
    "id": "typescript",
    "name": {
      "ja": "TypeScript CLI",
      "en": "TypeScript CLI"
    },
    "icon": "🔷",
    "desc": {
      "ja": "TypeScript のコマンドラインスクリプト(型つき変数・tsconfig つき)",
      "en": "TypeScript command-line script (typed variables, tsconfig)"
    },
    "version": "0.1.0"
  },
  "target": {
    "language": [
      "typescript"
    ],
    "platforms": [
      "windows",
      "macos",
      "linux"
    ]
  },
  "capabilities": [
    "variables",
    "conditions",
    "loops",
    "functions",
    "filesystem",
    "cli",
    "io",
    "input"
  ],
  "types": {
    "toStr": "String({a})",
    "toNum": "Number({a})",
    "toBool": "Boolean({a})",
    "varTypes": {
      "Number": "number",
      "String": "string",
      "Boolean": "boolean"
    }
  },
  "expressions": {
    "concat": " + ",
    "calls": {
      "contains": "{a}.includes({b})",
      "isEmpty": "({a}.length === 0)",
      "pow": "({a} ** {b})",
      "random": "randomInt({a}, {b})",
      "ternary": "({a} ? {b} : {c})"
    }
  },
  "statements": {
    "comment": "// {text}",
    "globalDecl": "let {name}: {type} = {value};",
    "set": "{target} = {value};",
    "log": "console.log({value});",
    "call": "{fn}({args});",
    "wait": "sleep({ms});",
    "print": "console.log({value});",
    "printInline": "process.stdout.write({value});",
    "exit": "process.exit({code});"
  },
  "io": {
    "readLine": "readLine()",
    "arg": "(process.argv[{a} + 1] ?? \"\")",
    "readFile": "readFile({a})",
    "fileExists": "fs.existsSync({a})",
    "writeFile": "fs.writeFileSync({path}, {text});",
    "appendFile": "fs.appendFileSync({path}, {text});"
  },
  "conditions": {
    "ifOpen": "if ({cond}) {",
    "elseOpen": "} else {"
  },
  "loops": {
    "repeatOpen": "for (let {i} = 0; {i} < {count}; {i}++) {"
  },
  "functions": {
    "fnOpen": "function {name}({params}) {",
    "fnParam": "{name}: any"
  },
  "syntax": {
    "indent": "  ",
    "close": "}"
  },
  "mappings": {
    "imports": {
      "readLine": "import * as fs from \"node:fs\";",
      "readFile": "import * as fs from \"node:fs\";",
      "fileExists": "import * as fs from \"node:fs\";",
      "writeFile": "import * as fs from \"node:fs\";",
      "appendFile": "import * as fs from \"node:fs\";"
    },
    "helpers": {
      "wait": "function sleep(ms: number): void {\n  Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, Math.max(0, ms));\n}",
      "random": "function randomInt(min: number, max: number): number {\n  return Math.floor(min + Math.random() * (max - min + 1));\n}",
      "readLine": "let stdinLines: string[] | null = null;\nfunction readLine(): string {\n  if (stdinLines === null) stdinLines = fs.readFileSync(0, \"utf8\").split(/\\r?\\n/);\n  return stdinLines.shift() ?? \"\";\n}",
      "readFile": "function readFile(path: string): string {\n  try {\n    return fs.readFileSync(path, \"utf8\");\n  } catch (e) {\n    return \"\";\n  }\n}"
    }
  },
  "templates": {
    "program": {
      "file": "main.ts",
      "template": "// {{name}} — {{note}}\n{{imports}}\n\n{{helpers}}\n\n{{globals}}\n\n{{functions}}\n\n{{main}}\n"
    },
    "files": {
      "package.json": "{\n  \"name\": {{json slug}},\n  \"version\": {{json version}},\n  \"private\": true,\n  \"type\": \"module\",\n  \"scripts\": { \"start\": \"tsx main.ts\", \"check\": \"tsc --noEmit\" },\n  \"devDependencies\": { \"@types/node\": \"^20.0.0\", \"tsx\": \"^4.0.0\", \"typescript\": \"^5.0.0\" }\n}\n",
      "tsconfig.json": "{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"module\": \"ESNext\",\n    \"moduleResolution\": \"Bundler\",\n    \"strict\": true,\n    \"noEmit\": true,\n    \"types\": [\"node\"]\n  },\n  \"include\": [\"main.ts\"]\n}\n",
      "README.md": "# {{name}}\n\nA TypeScript program generated by [Codiram](https://github.com/Yumenyan/Codiram).\nCodiram is not needed to run or edit it.\n\n```sh\nnpm install\nnpm start        # runs main.ts with tsx\nnpm run check    # type check\n```\n",
      ".gitignore": "node_modules\n"
    }
  },
  "scaffold": {
    "config": {
      "version": "0.1.0"
    },
    "configFields": [
      {
        "key": "version",
        "label": "Version"
      }
    ]
  },
  "verify": {
    "requiredFiles": [
      "main.ts",
      "package.json",
      "tsconfig.json"
    ],
    "json": [
      "package.json",
      "tsconfig.json"
    ],
    "run": {
      "tool": "node",
      "args": [
        "--experimental-strip-types",
        "--no-warnings",
        "main.ts"
      ]
    }
  }
}
