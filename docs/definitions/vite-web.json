{
  "format": "codiram-generator",
  "schemaVersion": 2,
  "kind": "project",
  "generator": {
    "id": "vite-web",
    "name": {
      "ja": "Web (Vite)",
      "en": "Web (Vite)"
    },
    "icon": "⚡",
    "desc": {
      "ja": "Web アプリを Vite プロジェクトとして包みます(npm run dev / build)",
      "en": "Wraps the web app in a Vite project (npm run dev / build)"
    },
    "version": "0.1.0"
  },
  "target": {
    "language": [
      "html",
      "css",
      "javascript"
    ],
    "platforms": [
      "browser"
    ]
  },
  "capabilities": [],
  "templates": {
    "files": {
      "package.json": "{\n  \"name\": {{json slug}},\n  \"version\": {{json version}},\n  \"private\": true,\n  \"scripts\": { \"dev\": \"vite\", \"build\": \"vite build\", \"preview\": \"vite preview\" },\n  \"devDependencies\": { \"vite\": \"^5.0.0\" }\n}\n",
      "vite.config.js": "export default {\n  base: \"./\",\n};\n",
      ".gitignore": "node_modules\ndist\n",
      "README.md": "# {{name}}\n\nA web app generated by [Codiram](https://github.com/Yumenyan/Codiram) and wrapped as a Vite project.\nCodiram is not needed to build or edit it.\n\n```sh\nnpm install\nnpm run dev      # development server\nnpm run build    # production build in dist/\n```\n"
    }
  },
  "scaffold": {
    "config": {
      "version": "0.1.0"
    },
    "configFields": [
      {
        "key": "version",
        "label": "Version"
      }
    ],
    "source": {
      "generator": "web",
      "dir": "",
      "exclude": [
        "README.md"
      ]
    }
  },
  "verify": {
    "requiredFiles": [
      "index.html",
      "app.js",
      "package.json",
      "vite.config.js"
    ],
    "json": [
      "package.json"
    ],
    "syntax": {
      "js": [
        "app.js"
      ]
    }
  }
}
