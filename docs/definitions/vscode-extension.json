{
  "format": "codiram-generator",
  "schemaVersion": 2,
  "kind": "syntax",
  "generator": {
    "id": "vscode-extension",
    "name": {
      "ja": "VS Code 拡張機能",
      "en": "VS Code extension"
    },
    "icon": "🧩",
    "desc": {
      "ja": "VS Code 拡張機能(コマンド実行でロジックが動き、出力は通知で表示)",
      "en": "VS Code extension (the logic runs from a command; output is shown as notifications)"
    },
    "version": "0.0.1"
  },
  "target": {
    "language": [
      "javascript"
    ],
    "platforms": [
      "vscode"
    ]
  },
  "capabilities": [
    "variables",
    "conditions",
    "loops",
    "functions",
    "io",
    "extension"
  ],
  "types": {
    "toStr": "String({a})",
    "toNum": "Number({a})",
    "toBool": "Boolean({a})"
  },
  "expressions": {
    "concat": " + ",
    "calls": {
      "contains": "{a}.includes({b})",
      "isEmpty": "({a}.length === 0)",
      "pow": "({a} ** {b})",
      "random": "randomInt({a}, {b})",
      "ternary": "({a} ? {b} : {c})"
    }
  },
  "statements": {
    "comment": "// {text}",
    "globalDecl": "let {name} = {value};",
    "set": "{target} = {value};",
    "log": "vscode.window.showInformationMessage({value});",
    "call": "{fn}({args});",
    "print": "vscode.window.showInformationMessage({value});",
    "printInline": "process.stdout.write({value});"
  },
  "conditions": {
    "ifOpen": "if ({cond}) {",
    "elseOpen": "} else {"
  },
  "loops": {
    "repeatOpen": "for (let {i} = 0; {i} < {count}; {i}++) {"
  },
  "functions": {
    "fnOpen": "function {name}({params}) {"
  },
  "events": {
    "mainIndent": "    "
  },
  "syntax": {
    "indent": "  ",
    "close": "}"
  },
  "mappings": {
    "imports": {},
    "helpers": {
      "random": "function randomInt(min, max) {\n  return Math.floor(min + Math.random() * (max - min + 1));\n}"
    }
  },
  "templates": {
    "program": {
      "file": "extension.js",
      "template": "\"use strict\";\n// {{name}} — {{note}}\nconst vscode = require(\"vscode\");\n\n{{helpers}}\n\n{{globals}}\n\n{{functions}}\n\nfunction activate(context) {\n  context.subscriptions.push(vscode.commands.registerCommand({{json commandId}}, () => {\n{{main}}\n  }));\n}\n\nfunction deactivate() {}\n\nmodule.exports = { activate, deactivate };\n"
    },
    "files": {
      "package.json": "{\n  \"name\": {{json slug}},\n  \"displayName\": {{json name}},\n  \"version\": {{json version}},\n  \"engines\": { \"vscode\": \"^1.80.0\" },\n  \"main\": \"./extension.js\",\n  \"activationEvents\": [],\n  \"contributes\": {\n    \"commands\": [{ \"command\": {{json commandId}}, \"title\": {{json commandTitle}} }]\n  }\n}\n",
      ".vscodeignore": ".vscode/**\n",
      "README.md": "# {{name}}\n\nA VS Code extension generated by [Codiram](https://github.com/Yumenyan/Codiram).\nCodiram is not needed to run or edit it.\n\n```sh\ncode --extensionDevelopmentPath=.   # then run \"Codiram: Run\" from the command palette\n```\n"
    }
  },
  "scaffold": {
    "config": {
      "version": "0.0.1",
      "commandId": "codiram.run",
      "commandTitle": "Codiram: Run"
    },
    "configFields": [
      {
        "key": "version",
        "label": "Version"
      },
      {
        "key": "commandId",
        "label": "Command id (publisher.name)"
      },
      {
        "key": "commandTitle",
        "label": "Command title"
      }
    ]
  },
  "verify": {
    "requiredFiles": [
      "extension.js",
      "package.json"
    ],
    "json": [
      "package.json"
    ],
    "syntax": {
      "js": [
        "extension.js"
      ]
    },
    "contains": {
      "extension.js": [
        "registerCommand"
      ]
    }
  }
}
