{
  "format": "codiram-generator",
  "schemaVersion": 2,
  "kind": "syntax",
  "generator": {
    "id": "nodejs-cli",
    "name": {
      "ja": "Node.js CLI",
      "en": "Node.js CLI"
    },
    "icon": "🟢",
    "desc": {
      "ja": "Node.js のコマンドラインスクリプトを生成します",
      "en": "Generates a Node.js command-line script"
    },
    "version": "0.1.0"
  },
  "target": {
    "language": [
      "javascript"
    ],
    "platforms": [
      "windows",
      "macos",
      "linux"
    ]
  },
  "capabilities": [
    "variables",
    "conditions",
    "loops",
    "functions",
    "filesystem",
    "cli",
    "io"
  ],
  "types": {
    "toStr": "String({a})",
    "toNum": "Number({a})",
    "toBool": "Boolean({a})"
  },
  "expressions": {
    "concat": " + ",
    "calls": {
      "contains": "{a}.includes({b})",
      "isEmpty": "({a}.length === 0)",
      "pow": "({a} ** {b})",
      "random": "randomInt({a}, {b})",
      "ternary": "({a} ? {b} : {c})"
    }
  },
  "statements": {
    "comment": "// {text}",
    "globalDecl": "let {name} = {value};",
    "set": "{target} = {value};",
    "log": "console.log({value});",
    "call": "{fn}({args});",
    "wait": "sleep({ms});",
    "print": "console.log({value});",
    "printInline": "process.stdout.write({value});",
    "exit": "process.exit({code});"
  },
  "io": {
    "readLine": "readLine()",
    "arg": "(process.argv[{a} + 1] ?? \"\")",
    "readFile": "readFile({a})",
    "fileExists": "fs.existsSync({a})",
    "writeFile": "fs.writeFileSync({path}, {text});",
    "appendFile": "fs.appendFileSync({path}, {text});"
  },
  "conditions": {
    "ifOpen": "if ({cond}) {",
    "elseOpen": "} else {"
  },
  "loops": {
    "repeatOpen": "for (let {i} = 0; {i} < {count}; {i}++) {"
  },
  "functions": {
    "fnOpen": "function {name}({params}) {"
  },
  "syntax": {
    "indent": "  ",
    "close": "}"
  },
  "mappings": {
    "imports": {
      "readLine": "const fs = require(\"fs\");",
      "readFile": "const fs = require(\"fs\");",
      "fileExists": "const fs = require(\"fs\");",
      "writeFile": "const fs = require(\"fs\");",
      "appendFile": "const fs = require(\"fs\");"
    },
    "helpers": {
      "wait": "function sleep(ms) {\n  Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, Math.max(0, ms));\n}",
      "random": "function randomInt(min, max) {\n  return Math.floor(min + Math.random() * (max - min + 1));\n}",
      "readLine": "let stdinLines = null;\nfunction readLine() {\n  if (stdinLines === null) stdinLines = fs.readFileSync(0, \"utf8\").split(/\\r?\\n/);\n  return stdinLines.length ? stdinLines.shift() : \"\";\n}",
      "readFile": "function readFile(path) {\n  try {\n    return fs.readFileSync(path, \"utf8\");\n  } catch (e) {\n    return \"\";\n  }\n}"
    }
  },
  "templates": {
    "program": {
      "file": "main.js",
      "template": "\"use strict\";\n// {{name}} — {{note}}\n{{imports}}\n\n{{helpers}}\n\n{{globals}}\n\n{{functions}}\n\n{{main}}\n"
    },
    "files": {
      "package.json": "{\n  \"name\": {{json slug}},\n  \"version\": {{json version}},\n  \"private\": true,\n  \"scripts\": { \"start\": \"node main.js\" }\n}\n",
      "README.md": "# {{name}}\n\nA command-line script generated by [Codiram](https://github.com/Yumenyan/Codiram) (Node.js generator).\nNo dependencies — Codiram is not needed to run or edit it.\n\n```sh\nnode main.js\n```\n"
    }
  },
  "scaffold": {
    "config": {
      "version": "0.1.0"
    },
    "configFields": [
      {
        "key": "version",
        "label": "Version"
      }
    ]
  },
  "verify": {
    "requiredFiles": [
      "main.js",
      "package.json"
    ],
    "json": [
      "package.json"
    ],
    "run": {
      "tool": "node",
      "args": [
        "main.js"
      ]
    }
  }
}
