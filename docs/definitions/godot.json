{
  "format": "codiram-generator",
  "schemaVersion": 2,
  "kind": "syntax",
  "generator": {
    "id": "godot",
    "name": {
      "ja": "Godot (GDScript)",
      "en": "Godot (GDScript)"
    },
    "icon": "🎮",
    "desc": {
      "ja": "Godot 4 プロジェクト(main.gd にロジックを生成)",
      "en": "Godot 4 project (logic generated into main.gd)"
    },
    "version": "0.1.0"
  },
  "target": {
    "language": [
      "gdscript"
    ],
    "platforms": [
      "windows",
      "macos",
      "linux"
    ]
  },
  "capabilities": [
    "variables",
    "conditions",
    "loops",
    "functions",
    "io"
  ],
  "types": {
    "true": "true",
    "false": "false",
    "null": "null",
    "toStr": "str({a})",
    "toStrNum": "fmt_num({a})",
    "toNum": "float({a})",
    "toBool": "bool({a})"
  },
  "expressions": {
    "not": "(not {a})",
    "neg": "(-{a})",
    "concat": " + ",
    "ops": {
      "&&": "and",
      "||": "or"
    },
    "calls": {
      "contains": "({b} in {a})",
      "isEmpty": "({a}.length() == 0)",
      "pow": "pow({a}, {b})",
      "random": "randi_range(int({a}), int({b}))",
      "ternary": "({b} if {a} else {c})"
    }
  },
  "statements": {
    "comment": "# {text}",
    "globalDecl": "var {name} = {value}",
    "set": "{target} = {value}",
    "log": "print({value})",
    "call": "{fn}({args})",
    "print": "print({value})"
  },
  "conditions": {
    "ifOpen": "if {cond}:",
    "elseOpen": "else:"
  },
  "loops": {
    "repeatOpen": "for {i} in range(int({count})):"
  },
  "functions": {
    "fnOpen": "func {name}({params}):"
  },
  "events": {
    "mainOpen": "func _ready():"
  },
  "syntax": {
    "indent": "\t",
    "close": "",
    "emptyBody": "pass"
  },
  "mappings": {
    "helpers": {
      "toStrNum": "func fmt_num(value) -> String:\n\t# Number to text: 3 instead of 3.0\n\treturn str(int(value)) if is_equal_approx(value, round(value)) else str(value)"
    }
  },
  "templates": {
    "program": {
      "file": "main.gd",
      "template": "extends Node\n# {{name}} — {{note}}\n\n{{helpers}}\n\n{{globals}}\n\n{{functions}}\n\n{{main}}\n"
    },
    "files": {
      "project.godot": "config_version=5\n\n[application]\n\nconfig/name={{json name}}\nrun/main_scene=\"res://main.tscn\"\nconfig/features=PackedStringArray(\"4.2\")\n",
      "main.tscn": "[gd_scene load_steps=2 format=3]\n\n[ext_resource type=\"Script\" path=\"res://main.gd\" id=\"1\"]\n\n[node name=\"Main\" type=\"Node\"]\nscript = ExtResource(\"1\")\n",
      "README.md": "# {{name}}\n\nA Godot 4 project generated by [Codiram](https://github.com/Yumenyan/Codiram).\nCodiram is not needed to run or edit it.\n\n```sh\ngodot --path . --headless   # or open the folder in the Godot editor and press F5\n```\n",
      ".gitignore": ".godot/\n"
    }
  },
  "scaffold": {
    "config": {
      "version": "0.1.0"
    },
    "configFields": [
      {
        "key": "version",
        "label": "Version"
      }
    ]
  },
  "verify": {
    "requiredFiles": [
      "project.godot",
      "main.tscn",
      "main.gd"
    ],
    "contains": {
      "main.gd": [
        "extends Node",
        "func _ready():"
      ]
    }
  }
}
