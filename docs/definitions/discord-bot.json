{
  "format": "codiram-generator",
  "schemaVersion": 2,
  "kind": "syntax",
  "generator": {
    "id": "discord-bot",
    "name": {
      "ja": "Discord Bot",
      "en": "Discord bot"
    },
    "icon": "🤖",
    "desc": {
      "ja": "discord.js の Bot(「コマンドを受け取ったとき」から返信)",
      "en": "discord.js bot (reply when a command is received)"
    },
    "version": "0.1.0"
  },
  "target": {
    "language": [
      "javascript"
    ],
    "platforms": [
      "node"
    ]
  },
  "capabilities": [
    "variables",
    "conditions",
    "loops",
    "functions",
    "io",
    "bot"
  ],
  "types": {
    "toStr": "String({a})",
    "toNum": "Number({a})",
    "toBool": "Boolean({a})"
  },
  "expressions": {
    "concat": " + ",
    "calls": {
      "contains": "{a}.includes({b})",
      "isEmpty": "({a}.length === 0)",
      "pow": "({a} ** {b})",
      "random": "randomInt({a}, {b})",
      "ternary": "({a} ? {b} : {c})"
    }
  },
  "statements": {
    "comment": "// {text}",
    "globalDecl": "let {name} = {value};",
    "set": "{target} = {value};",
    "log": "console.log({value});",
    "call": "{fn}({args});",
    "print": "console.log({value});",
    "printInline": "process.stdout.write({value});"
  },
  "conditions": {
    "ifOpen": "if ({cond}) {",
    "elseOpen": "} else {"
  },
  "loops": {
    "repeatOpen": "for (let {i} = 0; {i} < {count}; {i}++) {"
  },
  "functions": {
    "fnOpen": "function {name}({params}) {"
  },
  "events": {
    "eventHandlers": {
      "bot.command": "client.on(\"messageCreate\", async (message) => {\n  if (message.author.bot || !message.content.startsWith(\"{command}\")) return;\n  const args = message.content.slice(\"{command}\".length).trim();\n  {body}\n});"
    }
  },
  "extensions": {
    "customStatements": {
      "bot.reply": "message.reply({text});"
    },
    "customValues": {
      "bot.author": "message.author.username",
      "bot.args": "args",
      "bot.content": "message.content"
    }
  },
  "syntax": {
    "indent": "  ",
    "close": "}"
  },
  "mappings": {
    "imports": {},
    "helpers": {
      "random": "function randomInt(min, max) {\n  return Math.floor(min + Math.random() * (max - min + 1));\n}"
    }
  },
  "templates": {
    "program": {
      "file": "bot.js",
      "template": "\"use strict\";\n// {{name}} — {{note}}\nconst { Client, GatewayIntentBits } = require(\"discord.js\");\n\nconst client = new Client({\n  intents: [GatewayIntentBits.Guilds, GatewayIntentBits.GuildMessages, GatewayIntentBits.MessageContent],\n});\nclient.once(\"ready\", () => console.log(`Logged in as ${client.user.tag}`));\n\n{{helpers}}\n\n{{globals}}\n\n{{functions}}\n\nclient.login(process.env.DISCORD_TOKEN);\n"
    },
    "files": {
      "package.json": "{\n  \"name\": {{json slug}},\n  \"version\": {{json version}},\n  \"private\": true,\n  \"scripts\": { \"start\": \"node bot.js\" },\n  \"dependencies\": { \"discord.js\": \"^14.0.0\" }\n}\n",
      ".env.example": "DISCORD_TOKEN=your-bot-token\n",
      "README.md": "# {{name}}\n\nA Discord bot generated by [Codiram](https://github.com/Yumenyan/Codiram).\nCodiram is not needed to run or edit it.\n\n```sh\nnpm install\nDISCORD_TOKEN=... npm start   # enable \"Message Content Intent\" for the bot in the Discord developer portal\n```\n",
      ".gitignore": "node_modules\n.env\n"
    }
  },
  "scaffold": {
    "config": {
      "version": "0.1.0"
    },
    "configFields": [
      {
        "key": "version",
        "label": "Version"
      }
    ]
  },
  "verify": {
    "requiredFiles": [
      "bot.js",
      "package.json"
    ],
    "json": [
      "package.json"
    ],
    "syntax": {
      "js": [
        "bot.js"
      ]
    },
    "contains": {
      "bot.js": [
        "client.login",
        "message.reply("
      ]
    }
  }
}
