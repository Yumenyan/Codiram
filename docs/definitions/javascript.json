{
  "format": "codiram-generator",
  "schemaVersion": 2,
  "kind": "syntax",
  "generator": {
    "id": "javascript",
    "name": {
      "ja": "JavaScript",
      "en": "JavaScript"
    },
    "icon": "🟨",
    "desc": {
      "ja": "素の JavaScript(console 出力のみ。Node.js でもブラウザでも動作)",
      "en": "Plain JavaScript (console output only; runs in Node.js and browsers)"
    },
    "version": "0.1.0"
  },
  "target": {
    "language": [
      "javascript"
    ],
    "platforms": [
      "browser",
      "node"
    ]
  },
  "capabilities": [
    "variables",
    "conditions",
    "loops",
    "functions",
    "io"
  ],
  "types": {
    "toStr": "String({a})",
    "toNum": "Number({a})",
    "toBool": "Boolean({a})"
  },
  "expressions": {
    "concat": " + ",
    "calls": {
      "contains": "{a}.includes({b})",
      "isEmpty": "({a}.length === 0)",
      "pow": "({a} ** {b})",
      "random": "randomInt({a}, {b})",
      "ternary": "({a} ? {b} : {c})"
    }
  },
  "statements": {
    "comment": "// {text}",
    "globalDecl": "let {name} = {value};",
    "set": "{target} = {value};",
    "log": "console.log({value});",
    "call": "{fn}({args});",
    "print": "console.log({value});",
    "printInline": "process.stdout.write({value});"
  },
  "conditions": {
    "ifOpen": "if ({cond}) {",
    "elseOpen": "} else {"
  },
  "loops": {
    "repeatOpen": "for (let {i} = 0; {i} < {count}; {i}++) {"
  },
  "functions": {
    "fnOpen": "function {name}({params}) {"
  },
  "syntax": {
    "indent": "  ",
    "close": "}"
  },
  "mappings": {
    "imports": {},
    "helpers": {
      "random": "function randomInt(min, max) {\n  return Math.floor(min + Math.random() * (max - min + 1));\n}"
    }
  },
  "templates": {
    "program": {
      "file": "script.js",
      "template": "\"use strict\";\n// {{name}} — {{note}}\n{{imports}}\n\n{{helpers}}\n\n{{globals}}\n\n{{functions}}\n\n{{main}}\n"
    },
    "files": {
      "README.md": "# {{name}}\n\nA JavaScript program generated by [Codiram](https://github.com/Yumenyan/Codiram).\nCodiram is not needed to run or edit it.\n\n```sh\nnode script.js\n```\n"
    }
  },
  "scaffold": {
    "config": {
      "version": "0.1.0"
    },
    "configFields": [
      {
        "key": "version",
        "label": "Version"
      }
    ]
  },
  "verify": {
    "requiredFiles": [
      "script.js",
      "README.md"
    ],
    "syntax": {
      "js": [
        "script.js"
      ]
    },
    "run": {
      "tool": "node",
      "args": [
        "script.js"
      ]
    }
  }
}
