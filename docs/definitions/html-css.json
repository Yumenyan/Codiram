{
  "format": "codiram-generator",
  "schemaVersion": 2,
  "kind": "project",
  "generator": {
    "id": "html-css",
    "name": {
      "ja": "HTML / CSS(見た目のみ)",
      "en": "HTML / CSS only"
    },
    "icon": "🎨",
    "desc": {
      "ja": "Design の見た目だけを HTML と CSS として書き出します(JavaScript なし)",
      "en": "The Design as plain HTML and CSS (no JavaScript)"
    },
    "version": "0.1.0"
  },
  "target": {
    "language": [
      "html",
      "css"
    ],
    "platforms": [
      "browser"
    ]
  },
  "capabilities": [],
  "templates": {
    "files": {
      "README.md": "# {{name}}\n\nA static HTML / CSS page (no JavaScript) generated by [Codiram](https://github.com/Yumenyan/Codiram).\nCodiram is not needed to run or edit it.\n\n```sh\nopen index.html\n```\n"
    }
  },
  "scaffold": {
    "config": {
      "version": "0.1.0"
    },
    "configFields": [
      {
        "key": "version",
        "label": "Version"
      }
    ],
    "source": {
      "generator": "web",
      "dir": "",
      "exclude": [
        "README.md"
      ],
      "config": {
        "htmlOnly": true
      }
    }
  },
  "verify": {
    "requiredFiles": [
      "index.html",
      "style.css"
    ],
    "contains": {
      "index.html": [
        "<html"
      ]
    }
  }
}
