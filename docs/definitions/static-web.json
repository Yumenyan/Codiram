{
  "format": "codiram-generator",
  "schemaVersion": 2,
  "kind": "project",
  "generator": {
    "id": "static-web",
    "name": {
      "ja": "Static Web(静的サイト)",
      "en": "Static Web"
    },
    "icon": "📄",
    "desc": {
      "ja": "静的ホスティング向け(GitHub Pages / Netlify)。404.html と配信設定つき",
      "en": "For static hosting (GitHub Pages / Netlify), with 404.html and hosting config"
    },
    "version": "0.1.0"
  },
  "target": {
    "language": [
      "html",
      "css",
      "javascript"
    ],
    "platforms": [
      "browser"
    ]
  },
  "capabilities": [],
  "templates": {
    "files": {
      "404.html": "<!doctype html>\n<meta charset=\"utf-8\">\n<title>Not found</title>\n<p>Page not found. <a href=\"./\">Back to {{name}}</a></p>\n",
      ".nojekyll": "",
      "netlify.toml": "[build]\n  publish = \".\"\n",
      "README.md": "# {{name}}\n\nA static website generated by [Codiram](https://github.com/Yumenyan/Codiram).\nCodiram is not needed to run or edit it.\n\n```sh\npython3 -m http.server 8000   # open http://localhost:8000\n# GitHub Pages: push this folder; Netlify: drag & drop the folder\n```\n"
    }
  },
  "scaffold": {
    "config": {
      "version": "0.1.0"
    },
    "configFields": [
      {
        "key": "version",
        "label": "Version"
      }
    ],
    "source": {
      "generator": "web",
      "dir": "",
      "exclude": [
        "README.md"
      ]
    }
  },
  "verify": {
    "requiredFiles": [
      "index.html",
      "app.js",
      "404.html",
      ".nojekyll"
    ],
    "syntax": {
      "js": [
        "app.js"
      ]
    }
  }
}
